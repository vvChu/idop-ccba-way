{
  "$schema": "datamodel/sharepoint/schemas/sp-list.schema.json",
  "ListName": "Opportunities",
  "Description": "Cơ hội kinh doanh của CCBA",
  "Columns": [
    {
      "Name": "OpportunityName",
      "Type": "Text",
      "Required": true,
      "DisplayName": "Tên cơ hội"
    },
    {
      "Name": "PotentialProject",
      "Type": "Lookup",
      "Lookup": {
        "List": "PotentialProjects",
        "Field": "ID",
        "Behavior": "restrict"
      },
      "DisplayName": "Tiềm năng dự án"
    },
    {
      "Name": "Customer",
      "Type": "Lookup",
      "Lookup": {
        "List": "Customers",
        "Field": "ID",
        "Behavior": "restrict"
      },
      "DisplayName": "Khách hàng"
    },
    {
      "Name": "Contact",
      "Type": "Lookup",
      "Lookup": {
        "List": "Contacts",
        "Field": "ID",
        "Behavior": "restrict"
      },
      "DisplayName": "Liên hệ"
    },
    {
      "Name": "Stage",
      "Type": "Choice",
      "Choices": [
        "New",
        "Qualification Review",
        "Proposal/HSDX",
        "Closed - Won",
        "Closed - Lost",
        "Closed - Not Pursued"
      ],
      "DisplayName": "Giai đoạn"
    },
    {
      "Name": "ParticipationDecision",
      "Type": "Choice",
      "Choices": [
        "Unknown",
        "Yes",
        "No"
      ],
      "DisplayName": "Quyết định tham gia"
    },
    {
      "Name": "DecisionDate",
      "Type": "DateTime",
      "DisplayName": "Ngày quyết định"
    },
    {
      "Name": "DecisionNote",
      "Type": "Note",
      "DisplayName": "Ghi chú quyết định"
    },
    {
      "Name": "DecisionEmailLink",
      "Type": "Hyperlink",
      "DisplayName": "Liên kết email quyết định"
    },
    {
      "Name": "BiddingFolderDriveItemId",
      "Type": "Text",
      "DisplayName": "ID mục thư mục Hồ sơ thầu"
    },
    {
      "Name": "BiddingFolderUrl",
      "Type": "Hyperlink",
      "DisplayName": "URL thư mục Hồ sơ thầu"
    },
    {
      "Name": "BiddingFolderPath",
      "Type": "Text",
      "DisplayName": "Đường dẫn thư mục Hồ sơ thầu"
    },
    {
      "Name": "BiddingFolderState",
      "Type": "Choice",
      "Choices": [
        "Not Created",
        "Creating",
        "Created",
        "Failed"
      ],
      "DisplayName": "Trạng thái thư mục Hồ sơ thầu"
    },
    {
      "Name": "BiddingFolderPhase",
      "Type": "Choice",
      "Choices": [
        "Draft",
        "Confirmed",
        "Archived"
      ],
      "DisplayName": "Pha thư mục Hồ sơ thầu"
    },
    {
      "Name": "BiddingCode",
      "Type": "Text",
      "DisplayName": "Mã hồ sơ thầu"
    },
    {
      "Name": "BidTeam",
      "Type": "User",
      "UserSelectionMode": "PeopleAndGroups",
      "AllowMultiple": true,
      "DisplayName": "Nhóm dự thầu"
    },
    {
      "Name": "Value",
      "Type": "Number",
      "DisplayName": "Giá trị"
    },
    {
      "Name": "Probability",
      "Type": "Number",
      "DisplayName": "Xác suất"
    },
    {
      "Name": "AdjustedProbability",
      "Type": "Number",
      "Description": "Xác suất điều chỉnh sau InfluenceScore & Risk.",
      "DisplayName": "Xác suất điều chỉnh"
    },
    {
      "Name": "InfluenceScore",
      "Type": "Number",
      "Description": "Σ(InfluenceWeight * SupportFactor * EngagementFactor).",
      "DisplayName": "Điểm ảnh hưởng"
    },
    {
      "Name": "RiskFlags",
      "Type": "MultiChoice",
      "Choices": [
        "InfluenceLow",
        "MissingRoles",
        "StakeholderOpposition",
        "DataGap"
      ],
      "DisplayName": "Cờ rủi ro"
    },
    {
      "Name": "ServiceMixSummary",
      "Type": "Note",
      "Description": "Tổng hợp dịch vụ: <ServiceType>:<Count>(Won/Pending).",
      "DisplayName": "Tổng hợp dịch vụ"
    },
    {
      "Name": "ExpectedCloseDate",
      "Type": "DateTime",
      "DisplayName": "Ngày dự kiến chốt"
    },
    {
      "Name": "Status",
      "Type": "Choice",
      "Choices": [
        "Active",
        "Closed",
        "OnHold"
      ],
      "DisplayName": "Trạng thái"
    },
    {
      "Name": "ServiceType",
      "Type": "ManagedMetadata",
      "TermSet": {
        "Group": "CCBA Taxonomy",
        "Name": "CCBA_LoaiHinhDichVu"
      },
      "DisplayName": "Loại hình dịch vụ"
    },
    {
      "Name": "Industry",
      "Type": "ManagedMetadata",
      "TermSet": {
        "Group": "CCBA Taxonomy",
        "Name": "CCBA_NganhLinhVuc"
      },
      "DisplayName": "Ngành/Lĩnh vực"
    },
    {
      "Name": "Source",
      "Type": "ManagedMetadata",
      "TermSet": {
        "Group": "CCBA Taxonomy",
        "Name": "CCBA_NguonGocCoHoi"
      },
      "DisplayName": "Nguồn"
    },
    {
      "Name": "RelatedContracts",
      "Type": "Lookup",
      "Lookup": {
        "List": "Contracts",
        "Field": "ID",
        "Behavior": "restrict"
      },
      "DisplayName": "Hợp đồng liên quan"
    },
    {
      "Name": "RelatedProjects",
      "Type": "Lookup",
      "Lookup": {
        "List": "Projects",
        "Field": "ID",
        "Behavior": "restrict"
      },
      "DisplayName": "Dự án liên quan"
    },
    {
      "Name": "Owner",
      "Type": "User",
      "DisplayName": "Người phụ trách"
    }
  ],
  "ContentTypes": []
}
