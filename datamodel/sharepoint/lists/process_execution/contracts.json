{
  "$schema": "datamodel/sharepoint/schemas/sp-list.schema.json",
  "ListName": "Contracts",
  "Description": "Hợp đồng",
  "Columns": [
    {
      "Name": "ContractCode",
      "Type": "Text",
      "Required": true
    },
    {
      "Name": "ContractName",
      "Type": "Text",
      "Required": true
    },
    {
      "Name": "CustomerId",
      "Type": "Lookup",
      "Lookup": {
        "List": "Customers",
        "Field": "ID",
        "Behavior": "restrict"
      }
    },
    {
      "Name": "Currency",
      "Type": "Choice",
      "Choices": [
        "VND",
        "USD",
        "EUR"
      ]
    },
    {
      "Name": "VATRate",
      "Type": "Number"
    },
    {
      "Name": "GrossAmount",
      "Type": "Number"
    },
    {
      "Name": "NetAmount",
      "Type": "Number"
    },
    {
      "Name": "PrimaryContractGroup",
      "Type": "ManagedMetadata",
      "TermSet": {
        "Group": "CCBA Taxonomy",
        "Name": "CCBA_NhomHopDongKT"
      },
      "DisplayName": "Nhóm HĐKT chính (Phụ lục 7)"
    },
    {
      "Name": "CooperatingDepartment",
      "Type": "ManagedMetadata",
      "TermSet": {
        "Group": "CCBA Taxonomy",
        "Name": "CCBA_DonViPhongBan"
      },
      "DisplayName": "Đơn vị phối hợp (Viện IBST)"
    },
    {
      "Name": "Status",
      "Type": "ManagedMetadata",
      "TermSet": {
        "Group": "CCBA Taxonomy",
        "Name": "CCBA_TrangThaiChung"
      },
      "DisplayName": "Trạng thái"
    },
    {
      "Name": "LoaiKyKet",
      "Type": "Choice",
      "Choices": [
        "VienKy",
        "CCBAKy",
        "LienDanh"
      ],
      "DisplayName": "Loại ký kết HĐ",
      "Description": "Thẩm quyền ký HĐ: VienKy (> hạn mức GĐ CCBA), CCBAKy (trong hạn mức), LienDanh (nhiều đơn vị). Ref: QCTK 2815 Điều 6.1"
    },
    {
      "Name": "SignDate",
      "Type": "DateTime",
      "DisplayName": "Ngày ký hợp đồng"
    },
    {
      "Name": "OpportunityId",
      "Type": "Lookup",
      "Lookup": {
        "List": "Opportunities",
        "Field": "ID",
        "Behavior": "restrict"
      },
      "DisplayName": "Cơ hội kinh doanh (CRM)",
      "Description": "Liên kết ngược về Opportunity trên strategy_crm để truy vết nguồn gốc HĐ"
    },
    {
      "Name": "ServiceType",
      "Type": "ManagedMetadata",
      "TermSet": {
        "Group": "CCBA Taxonomy",
        "Name": "CCBA_LoaiHinhDichVu"
      },
      "DisplayName": "Loại hình dịch vụ chính"
    },
    {
      "Name": "DocumentUrl",
      "Type": "Hyperlink",
      "DisplayName": "Liên kết file HĐ (OneDrive)",
      "Description": "URL trỏ đến file HĐ scan/ký số trên 5TB Master OneDrive (02_Contracts/)"
    }
  ],
  "ContentTypes": []
}
