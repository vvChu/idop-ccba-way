{
  "$schema": "datamodel/sharepoint/schemas/sp-list.schema.json",
  "ListName": "Activities",
  "Description": "Hoạt động CRM/Marketing/R&D/Admin",
  "Columns": [
    {
      "Name": "ActivityName",
      "Type": "Text",
      "Required": true
    },
    {
