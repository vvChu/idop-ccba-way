{
  "$schema": "datamodel/sharepoint/schemas/sp-list.schema.json",
  
"ListName": "Assets",
"Description": "Tài sản",
"Columns": [
  { "Name": "AssetName", "Type": "Text", "Required": true },
  { "Name": "AssetCode", "Type": "Text" },
  { "Name": "AssignedTo", "Type": "Lookup",
    "Lookup": { "List": "Employees", "Field": "ID", "Behavior": "restrict" } },
  { "Name": "PurchaseDate", "Type": "DateTime" },
  { "Name": "OriginalValue", "Type": "Number", "Description": "Nguyên giá tài sản (VNĐ)" },
  { "Name": "DepreciationRate", "Type": "Number", "Description": "Tỷ lệ khấu hao hàng năm (%)" },
  { "Name": "AccumulatedDepreciation", "Type": "Number", "Description": "Khấu hao lũy kế (VNĐ)" },
  { "Name": "SerialNumber", "Type": "Text", "Description": "Số sê-ri thiết bị / sản phẩm" },
  { "Name": "Location", "Type": "Text", "Description": "Vị trí đặt / lưu giữ tài sản" },
  { "Name": "Status", "Type": "ManagedMetadata",
    "TermSet": { "Group": "CCBA Taxonomy", "Name": "CCBA_TrangThaiTaiSan" } }
],
"ContentTypes": []

}
